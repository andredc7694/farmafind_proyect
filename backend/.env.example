APP_MODE=bootstrap
HOST=127.0.0.1
PORT=3000

# F01 — modo local separado: copiar este esquema a backend/.env.f01.local (ignorado).
# Solo base ficticia aislada 127.0.0.1:55431/farmafind_f01_test[_sufijo].
# Se requieren dos usuarios LOGIN no privilegiados y distintos: auth y tenant.
# Nunca copiar credenciales a este ejemplo, a VITE_* ni a documentación compartida.
F01_DATABASE_URL=
F01_AUTH_DATABASE_URL=
F01_TEST_DATABASE_URL=
F01_CSRF_KEY_HEX=
F01_ABUSE_KEY_HEX=
F01_ALLOWED_ORIGIN=http://127.0.0.1:5173
F01_CSRF_TRUSTED_ORIGIN=http://127.0.0.1:5173
F01_COOKIE_SECURE=false
F01_ALLOW_HTTP_LOOPBACK=true
# F03 public search. Keep real local values in ignored files/environment.
SEARCH_REDIS_URL=redis://:fictitious-local-password@127.0.0.1:56379
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_CACHE_TIMEOUT_MS=150
SEARCH_CANDIDATE_LIMIT=200
