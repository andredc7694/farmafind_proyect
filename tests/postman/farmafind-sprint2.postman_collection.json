    {
      "name": "4. Protección contra abuso (límite real 60/min por IP)",
      "item": [
        {
          "name": "Búsqueda repetida hasta el 429",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get(\"burst\") || 0) + 1; pm.collectionVariables.set(\"burst\", n);",
                  "if (pm.response.code === 200 && n < 80) { pm.execution.setNextRequest(\"Búsqueda repetida hasta el 429\"); }",
                  "else { pm.test(\"llega al límite: 429 con Retry-After (intento \" + n + \")\", () => { pm.response.to.have.status(429); pm.expect(pm.response.headers.get(\"Retry-After\")).to.be.ok; }); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/busquedas?q=ibuprofeno"
          }
        }
      ]
