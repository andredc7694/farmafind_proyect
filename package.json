{
  "name": "farmafind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.17.0",
    "npm": "11.13.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "notifications"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @farmafind/frontend",
    "dev:api": "node scripts/f00/dev-service.mjs backend",
    "dev:identity": "npm run build --workspace @farmafind/backend && node scripts/f01/start.mjs",
    "dev:f02": "npm run build --workspace @farmafind/backend && node scripts/f02/start.mjs",
    "dev:f03": "npm run build --workspace @farmafind/backend && node scripts/f03/start.mjs",
    "dev:f04": "npm run build --workspace @farmafind/backend && node scripts/f04/start.mjs",
    "dev:notifications": "node scripts/f00/dev-service.mjs notifications",
    "build": "node scripts/f00/build.mjs",
    "check": "node scripts/f03/check-project.mjs",
    "check:config": "node scripts/f00/check-config.mjs",
    "test:base": "node node_modules/vitest/vitest.mjs run",
    "test:f01:unit": "node scripts/f01/check.mjs unit",
    "test:f01:api": "node scripts/f01/check.mjs api",
    "test:f01:rls": "node scripts/f01/check.mjs rls",
    "test:f02:unit": "node scripts/f02/check.mjs unit",
    "test:f02:rls": "node scripts/f02/check.mjs rls",
    "verify:f02:demo": "node scripts/f02/smoke.mjs",
    "test:f03:unit": "node scripts/f03/check.mjs unit",
    "test:f03:integration": "node scripts/f03/check.mjs integration",
    "test:f03:rls": "node scripts/f03/check.mjs rls",
    "verify:f03:demo": "node scripts/f03/smoke.mjs",
    "test:f03:load": "node scripts/f03/load.mjs",
    "test:f04:unit": "node scripts/f04/check.mjs unit",
    "test:f04:api": "node scripts/f04/check.mjs api",
    "test:f04:rls": "node scripts/f04/check.mjs rls",
    "test:f04:load": "node scripts/f04/load.mjs",
    "test:f04:e2e:linux": "node scripts/f04/run-browser-linux.mjs",
    "check:f04": "node scripts/f04/check-project.mjs",
    "expire:f04": "node scripts/f04/expire.mjs",
    "migrate:f01:test": "node scripts/f01/migrate.mjs",
    "verify:local": "node scripts/f00/verify-local.mjs",
    "browser:install": "node scripts/f00/browser-install.mjs",
    "verify:bootstrap": "node scripts/f00/verify-bootstrap.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jsdom": "31.0.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
